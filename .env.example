# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars)
# In production, set the three secrets with `npx wrangler secret put ...`

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPENROUTER_API_KEY=

# Optional override (also set in wrangler.toml [vars]; must be a :free model)
# OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# Used by scripts/set-webhook.mjs after deploy
# WEBHOOK_URL=https://bibi-golnar-bot.<account>.workers.dev/
